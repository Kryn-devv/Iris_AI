# Application Configuration
APP_NAME=IRIS
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./iris.db

# LLM Operating Mode: mock | local | auto
LLM_MODE=mock

# Local OpenAI-Compatible LLM Server Configuration
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=EMPTY
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_SECONDS=60

# Model Router Defaults
DEFAULT_PROVIDER=mock
DEFAULT_MODEL_MODE=reasoning
DEFAULT_MODEL=mock-model
FAST_MODEL=mock-fast
REASONING_MODEL=mock-reasoning
VISION_MODEL=
CODING_MODEL=mock-coding

# Agent Kernel Limits & Safety Guards
MAX_PLANNING_ITERATIONS=5
MAX_TOOL_CALLS=10
PER_TOOL_TIMEOUT_SECONDS=10
TOTAL_TASK_TIMEOUT_SECONDS=60

# Security Defaults
AUTO_APPROVE_LOW_RISK=true
