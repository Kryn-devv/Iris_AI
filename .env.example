# ══════════════════════════════════════════════════════════════════════
#  IRIS configuration — copy to .env and edit.
#  EVERYTHING here is optional: IRIS runs with zero configuration.
# ══════════════════════════════════════════════════════════════════════

# ── ESP32 boards dialling in (needed when IRIS runs on a VPS) ─────────
# With IRIS in the cloud it cannot call your boards: they sit behind your
# router's NAT. So they dial OUT to IRIS and hold a WebSocket open instead —
# no port-forwarding, no static IP, nothing exposed. See docs/CLOUD.md.
# REQUIRED for that to work: with no token every node connection is refused,
# because this channel drives the robot's motors.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# NODE_LINK_TOKEN=
# NODE_LINK_ENABLED=true
# NODE_VOICE_ENABLED=true        # accept mic audio from a node, answer with speech
# NODE_ALERTS_SPOKEN=true        # say it out loud the moment a node sees flame or gas

# ── Robot face (two OLED eyes on an ESP32-S3) ─────────────────────────
# The eyes follow whatever IRIS says by themselves — expression inferred from
# the sentence, plus a talking animation. Needs a device registered as 'face'
# (see docs/ESP32.md); harmless and silent with no face connected.
# FACE_AUTO_EXPRESSION=true

# ── Robot body — going places on its own ──────────────────────────────
# "take a U-turn", "go 2 metres", "go back to the board", "in 10 minutes come
# back". Distance and angle are timed from these two numbers (no encoders);
# say "one metre takes 3 seconds" / "a U-turn takes 2 seconds" to calibrate.
# ROBOT_CM_PER_S=35
# ROBOT_DEG_PER_S=110
# ROBOT_CRUISE_SPEED=200
# ROBOT_TURN_SPEED=190
# ROBOT_OBSTACLE_STOP_CM=35        # stop this close to whatever the ultrasonics see
# ROBOT_MAX_LEG_S=30               # no single leg drives longer than this

# ── The robot exploring on its own (see docs/ROAMING.md) ──────────────
# "go explore" and it works the room out itself: four ranked reflexes over
# the ultrasonics — escape, unwedge, avoid, cruise. Off unless asked, stops
# itself if the sensors go quiet, and "stop" always reaches it.
# ROBOT_ROAM_ENABLED=false         # true starts it roaming the moment IRIS boots
# ROBOT_ROAM_SPEED=150             # slower than cruising: more time to react
# ROBOT_ROAM_CRITICAL_CM=22        # under this, back off
# ROBOT_ROAM_CAUTION_CM=45         # under this, steer around
# ROBOT_ROAM_STEP_MS=400           # one forward pulse
# ROBOT_ROAM_TURN_MS=320           # one turn, before jitter
# ROBOT_ROAM_TICK_S=0.25           # matches the sense board's 4 x 60ms cycle
# ROBOT_ROAM_MAX_MINUTES=10        # parks itself after this long

# ── Robot eye (ESP32-CAM) ─────────────────────────────────────────────
# The camera watches on its own: greets people it knows the moment they
# appear, mentions strangers, names objects set down in front of it (needs
# VISION_MODEL below). Cheap when idle. Say "stop watching" to pause it.
# CAMERA_WATCH_ENABLED=true
# CAMERA_WATCH_INTERVAL_S=1.0      # how often to ask the camera "did anything move?"
# CAMERA_GREET_COOLDOWN_S=300      # greet the same person at most once per 5 minutes
# CAMERA_ANNOUNCE_STRANGERS=true
# CAMERA_WATCH_OBJECTS=true
# CAMERA_OBJECT_COOLDOWN_S=45

# ── Human mode — how she talks ────────────────────────────────────────
# Your name, so she can use it the way people do: now and then, for warmth,
# not in every sentence. Leave blank and she just won't use one.
# USER_NAME=Prakash
#
# Canned regex replies for "how are you" / "thanks" / "who are you". They
# answer instantly with no key and no network — but the model never sees those
# turns, so she forgets them and the thread breaks. Off by default now; she
# falls back to them automatically when no cloud provider is configured, so a
# zero-key install still talks.
# SMALLTALK_ENABLED=false
#
# Dress deterministic tool confirmations in her own voice: varied wording,
# never the same line twice running, warmer after a gap, terser mid-burst.
# The action stays deterministic either way — only the words move, and what a
# tool actually reported is never rewritten.
# PERSONA_ACKS=true
#
# How many recent exchanges ride along on every model call. Unbounded history
# is what blew through the free tier mid-conversation.
# HISTORY_MAX_TURNS=12
# ROLLING_SUMMARY_ENABLED=true   # fold older turns into notes she still knows
# RAPPORT_RETURN_GAP_MIN=25      # silence longer than this and she greets you
#
# Longest reply spoken before it is cut at a sentence boundary. The old 500
# was why she stopped mid-thought out loud.
# SPEECH_MAX_CHARS=1400
#
# Say "one sec" when a command that reaches the network goes quiet for this
# long, instead of leaving the room silent until the answer lands. The reply
# queues behind it rather than cutting it off. 0 turns it off.
# THINKING_FILLER_MS=900
#
# Appended to the end of every system prompt — for local models that need a
# control token (Qwen3 wants /no_think so chat answers instantly instead of
# reasoning for ten seconds first). Leave empty for Gemini and friends.
# PROMPT_SUFFIX=

# ── General ───────────────────────────────────────────────────────────
APP_NAME=IRIS
ASSISTANT_NAME=Iris
LOG_LEVEL=INFO
# HOST=127.0.0.1
# PORT=8756

# ── Free AI providers (add ANY ONE key to unlock full conversations) ──
# All of these have free tiers. If a model is retired, IRIS auto-switches
# to the best live model from the provider's catalog — no edits needed. Commands like "open youtube" work with
# no key at all. LLM_MODE: auto (default) | off | mock | cloud
LLM_MODE=auto

# OpenRouter — https://openrouter.ai/keys  (many ':free' models)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=z-ai/glm-5.2:free

# Groq — https://console.groq.com/keys  (very fast free tier)
# Tip: give it SEVERAL keys separated by commas (e.g. from different accounts)
# and IRIS rotates to the next key the moment one hits its rate limit:
# GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3
# (works for every provider's *_API_KEY, not just Groq)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio — https://aistudio.google.com/apikey  (free tier)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-flash-latest

# Cerebras — https://cloud.cerebras.ai  (free tier)
# CEREBRAS_API_KEY=csk-...

# Mistral — https://console.mistral.ai  (free experimental tier)
# MISTRAL_API_KEY=...

# Together — https://api.together.ai  (free models)
# TOGETHER_API_KEY=...

# GitHub Models — free with any GitHub personal access token
# GITHUB_MODELS_API_KEY=github_pat_...

# Hugging Face — https://huggingface.co/settings/tokens  (free credits)
# HUGGINGFACE_API_KEY=hf_...

# Any other OpenAI-compatible endpoint (LiteLLM, OmniRoute-style gateways…)
# OPENAI_COMPAT_BASE_URL=https://your-gateway/v1
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_MODEL=...

# Preferred provider order (first configured + healthy wins)
# LLM_PROVIDER_ORDER=openrouter,groq,gemini,cerebras,mistral,together,github_models,huggingface,openai_compat

# ── Voice ─────────────────────────────────────────────────────────────
VOICE_ENABLED=true
SPEAK_RESPONSES=true
WAKE_WORDS=iris,hey iris,ok iris
# STT_ENGINE: auto | faster_whisper | vosk | google_free | browser
STT_ENGINE=auto
# TTS_ENGINE: auto | piper | pyttsx3 | espeak | edge | gtts | browser
TTS_ENGINE=auto
# TTS_VOICE=            # e.g. en-US-AriaNeural for edge, or a pyttsx3 voice name

# ── Desktop behaviour ─────────────────────────────────────────────────
OPEN_BROWSER_ON_START=true
TRAY_ENABLED=true
# Enable "iris autostart enable" or say "start iris when my pc boots"

# ── Phone access (same Wi-Fi) ─────────────────────────────────────────
# Set true, restart, then open Settings ▸ Phone access in the UI for the
# QR code. A bearer token is enforced automatically for remote clients.
ALLOW_LAN_ACCESS=false

# ── Telegram (control IRIS from anywhere, free) ───────────────────────
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456:ABC-...        # from @BotFather
# TELEGRAM_ALLOWED_USER_IDS=123456789      # your numeric id (@userinfobot)

# ── Web tools ─────────────────────────────────────────────────────────
# DEFAULT_LOCATION=Mumbai                  # weather fallback location
# WEATHER_UNITS=metric                     # metric | imperial
# NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://hnrss.org/frontpage

# ── Safety ────────────────────────────────────────────────────────────
AUTO_APPROVE_DESKTOP_ACTIONS=true
ALLOW_HIGH_RISK_ACTIONS=false      # shutdown/restart need this + confirmation
ALLOW_SHELL_TOOL=false             # run_command tool stays off unless enabled
ALLOW_POWER_ACTIONS=false          # sleep/shutdown/restart master switch
# FS_ALLOWED_ROOTS=                # extra folders IRIS may touch (CSV)

# ── Storage ───────────────────────────────────────────────────────────
# DATABASE_URL=                    # default: per-user data dir sqlite
# IRIS_WORKSPACE_DIR=              # default: ~/Iris (outputs, projects…)

# ── Advanced (defaults are fine; listed so nothing is a secret) ───────
# Every setting IRIS reads lives in iris/app/core/config.py. The ones a
# person is likely to want are here with their defaults.
# API_TOKEN=                       # phone/LAN bearer token; auto-generated when blank ("iris token" prints it)
# REQUIRE_AUTH=false               # true: demand the token even from this machine
# RATE_LIMIT_PER_MINUTE=240        # per client, remote clients only
# AUTO_APPROVE_LOW_RISK=true       # false: confirm even reads and lookups
# LLM_FREE_ONLY=true               # refuse a paid model even when a key allows one
# LLM_TIMEOUT_SECONDS=60
# FAST_MODEL= / REASONING_MODEL= / CODING_MODEL=   # per-capability model overrides
# VISION_MODEL=                    # needed for "what is this?" through the robot's camera. Must accept images,
#                                  # e.g. meta-llama/llama-4-scout:free (OpenRouter) or gemini-flash-latest (Gemini)
# NLU_ENABLED=true                 # false: every message goes to the model (needs a key)
# WAKE_WORD_ENABLED=true
# STT_MODEL=base.en                # faster-whisper model size
# STT_LANGUAGE=auto                # or en, hi
# TTS_RATE=180 / TTS_VOLUME=0.9
# VOICE_BARGE_IN=true              # speaking over IRIS interrupts it
# SCHEDULER_ENABLED=true           # reminders, timers and routines
# HOTKEYS_ENABLED=true
# SUMMON_HOTKEY=ctrl+alt+space
# PUSH_TO_TALK_HOTKEY=ctrl+alt+i
# CLIPBOARD_WATCHER_ENABLED=false
# TUNNEL_PROVIDER=none             # none | cloudflared | ngrok
# TELEGRAM_POLL_INTERVAL=2.0
# WEB_SEARCH_PROVIDER=duckduckgo   # duckduckgo | searx | wikipedia
# SEARX_BASE_URL=https://searx.be
# UI_THEME=dark / UI_ACCENT=#5eead4
# UI_HOLOGRAM=true / UI_HOLOGRAM_QUALITY=high   # low | medium | high
# UI_REDUCED_MOTION=false
# DESKTOP_MODE=browser             # browser | webview | headless
# START_MINIMIZED=false
# LOG_TO_FILE=true / LOG_JSON=false
