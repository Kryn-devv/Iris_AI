# Re-include directories that the repo-root Python .gitignore excludes
# (lib/, build/, dist/, env/ are Python packaging patterns, not ours).
!lib/
!build/
!dist/
!env/

node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

.env
.env.local
.env.*.local

public/uploads/

npm-debug.log*
.DS_Store
