# --- Database -------------------------------------------------------------
# PostgreSQL connection string. `docker compose up -d db` provides a local one.
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform_dev"

# --- Auth -------------------------------------------------------------------
# Secret used to sign/derive session material. Generate: `openssl rand -hex 32`
AUTH_SECRET="change-me-in-production"

# --- AI provider abstraction ------------------------------------------------
# One of: heuristic | openai | anthropic
# "heuristic" is a deterministic, fully offline analyzer — the guaranteed
# fallback. Provider keys are only read when the matching provider is chosen.
AI_PROVIDER="heuristic"

# OpenAI-compatible endpoint (also works for OpenRouter, Groq, etc.)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- App --------------------------------------------------------------------
# Absolute origin used in emails/webhooks/embeds (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
